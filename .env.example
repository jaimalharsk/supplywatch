# Report generator
GEMINI_API_KEY=AQ....

# SupplyWatch live API (when wired up)
SUPPLYWATCH_API_KEY=sw-...

# Substack
# Create a free publication at substack.com, then fill these in
SUBSTACK_EMAIL=you@example.com
SUBSTACK_PASSWORD=yourpassword
SUBSTACK_PUBLICATION=supplywatch   # the subdomain — supplywatch.substack.com

# Reddit
# 1. Go to reddit.com/prefs/apps
# 2. Create app → type: script, redirect URI: http://localhost:8080
# 3. Copy client ID (under app name) and client secret
REDDIT_CLIENT_ID=abc123
REDDIT_CLIENT_SECRET=xyz789
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
